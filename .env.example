# Supabase (free tier) — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, server-only: lets /api/ratings write the shared ratings_cache.
# Without it, rating lookups still work — they just aren't cached in the DB.
SUPABASE_SERVICE_ROLE_KEY=

# Reddit application-only OAuth (free, server-side only) — reddit.com/prefs/apps,
# "create app" -> "script". Reddit's public search.json frequently 403s from
# datacenter IPs (Vercel included); this makes the buzz signal reliable in
# prod instead of silently absent (REFINEMENTS.md #15). Works anonymously
# without this, just less reliably — same credentials the community-mining
# Reddit harvester already documents using.
REDDIT_CLIENT_ID=
REDDIT_SECRET=

# Podcast Index (free key, server-side only — used from M1)
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# Listen Notes (free tier key, server-side only). Adds the Listen Score
# popularity signal to Top Picks / similar ranking. Header: X-ListenAPI-Key.
LISTEN_NOTES_API_KEY=

# 小宇宙 (Xiaoyuzhou) app-API tokens, server-side only. Optional — adds
# subscriber/play/comment buzz. Obtain via an ultrazg/xyz deployment (SMS
# login). The access token is short-lived; the refresh token renews it.
XIAOYUZHOU_ACCESS_TOKEN=
XIAOYUZHOU_REFRESH_TOKEN=

# YouTube Data API v3 (free key, server-side only). Adds a discussion/
# popularity signal (views/comments) and resolves real channel links.
YOUTUBE_API_KEY=

# Spotify (free, server-side only) — developer.spotify.com/dashboard,
# "Create app", any redirect URI (unused for this Client Credentials
# flow). Resolves real Spotify show URLs (REFINEMENTS.md #5); without it
# the Spotify icon stays on its title-search fallback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Podchaser (free tier, server-side only) — podchaser.com -> api.podchaser.com
# to request API access. Adds critic reviews / curated-list signal
# (REFINEMENTS.md #9).
PODCHASER_CLIENT_ID=
PODCHASER_CLIENT_SECRET=

# RSSHub base URL, server-side only. Public rsshub.app works with no setup
# (rate-limited); self-hosting (free on Vercel/Render, fork DIYgod/RSSHub)
# is more reliable. Powers the Douban and Zhihu community-mining harvesters
# — see docs/community-mining.md and REFINEMENTS.md #8.
RSSHUB_BASE=

# 知乎 (Zhihu) topic ids to watch, comma-separated. Community-mining is off
# for Zhihu until this is set (needs RSSHUB_BASE above too).
ZHIHU_TOPIC_IDS=

# Shared secret for /admin/health (REFINEMENTS.md #14) — the source
# health-check dashboard. Pick any random string; the endpoint is locked
# entirely (503) until this is set. Not a user account — just a token.
ADMIN_HEALTH_TOKEN=
